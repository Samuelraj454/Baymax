# LLM (required — platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_key_here
# Optional model overrides (defaults: gpt-4o / gpt-4o-mini)
# OPENAI_PRIMARY_MODEL=gpt-4o
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Email — Gmail App Password
# Setup: Google Account → Security → 2FA on → App Passwords → generate
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# WhatsApp — no key needed, uses pywhatkit + WhatsApp Web
# Just make sure WhatsApp Web is logged in on your default browser

# SMS via Twilio (optional — twilio.com/try-twilio for free trial)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# News (optional — newsapi.org free tier)
NEWS_API_KEY=your_news_api_key

# Voice — premium TTS (optional — elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_key

# Google Calendar (optional)
# Download credentials JSON from Google Cloud Console
GOOGLE_CALENDAR_CREDENTIALS=credentials/google_calendar.json
